exports[`snapshots > bank_accounts 1`] = `
"// Generated by scripts/codegen.ts from sdk-manifest.json. Do not edit.
// Run \`npm run codegen\` to regenerate.

import type { ToolCaller, ToolResult } from "../types.js";

export type BankAccountsListParams = {
  /**
   * Filter by enabled state. \`true\` returns only active accounts; \`false\`
   * returns disabled ones. Omit to include both.
   */
  enabled?: boolean | null;
  /**
   * Filter by source. \`true\` returns only manually created accounts; \`false\`
   * returns only provider-synced (Plaid/GoCardless/Teller/EnableBanking)
   * accounts. Omit to include both.
   */
  manual?: boolean | null;
};

/** Wire names of the \`bank_accounts\` tools, as returned by \`tools/list\`. */
export const BANK_ACCOUNTS_TOOLS = {
  list: "bank_accounts_list",
} as const;

export class BankAccountsNamespace {
  readonly #caller: ToolCaller;

  constructor(caller: ToolCaller) {
    this.#caller = caller;
  }

  /**
   * List bank accounts for the current team with the connected institution's
   * name + logo when available. Use this to discover bank account ids before
   * listing transactions, attaching payment info to an invoice, etc. Supports
   * filter by \`enabled\` (active accounts only) and \`manual\` (user-created vs.
   * provider-synced). Does NOT decrypt IBAN / account numbers — those require a
   * separate explicit reveal action.
   */
  list(params?: BankAccountsListParams): Promise<ToolResult> {
    return this.#caller.callTool(BANK_ACCOUNTS_TOOLS.list, params ?? {});
  }
}
"
`;

exports[`snapshots > tags 1`] = `
"// Generated by scripts/codegen.ts from sdk-manifest.json. Do not edit.
// Run \`npm run codegen\` to regenerate.

import type { ToolCaller, ToolResult } from "../types.js";

/** \`tags_list\` takes no arguments. */
export type TagsListParams = Record<string, never>;

export type TagsCreateParams = {
  /** Tag name (e.g., 'urgent', 'project-acme'). Must be unique within the team. */
  name: string;
};

export type TagsDeleteParams = {
  /** Tag id (UUID) to delete. This action is permanent. */
  id: string;
};

/** Wire names of the \`tags\` tools, as returned by \`tools/list\`. */
export const TAGS_TOOLS = {
  list: "tags_list",
  create: "tags_create",
  delete: "tags_delete",
} as const;

export class TagsNamespace {
  readonly #caller: ToolCaller;

  constructor(caller: ToolCaller) {
    this.#caller = caller;
  }

  /**
   * List all tags for the current team, ordered by name ascending. Tags are
   * simple {id, name} labels that can be attached to customers, transactions,
   * and tracker projects via their respective tools. No pagination — the tag
   * catalog is typically small.
   */
  list(params?: TagsListParams): Promise<ToolResult> {
    return this.#caller.callTool(TAGS_TOOLS.list, params ?? {});
  }

  /**
   * Create a new tag for the current team. Names are unique per team — creating
   * a tag whose name already exists throws a clear error (the caller should
   * reuse the existing tag id from tags_list). Tags are minimal: only a name is
   * stored (no color, no description). Returns {id, name}.
   */
  create(params: TagsCreateParams): Promise<ToolResult> {
    return this.#caller.callTool(TAGS_TOOLS.create, params);
  }

  /**
   * Permanently delete a tag. DESTRUCTIVE: also removes this tag from every
   * customer, transaction, and tracker project it is attached to. Those
   * customers, transactions, and tracker projects themselves are NOT affected,
   * only their tag links. There is no soft-delete/archive for tags. Returns {id,
   * deleted: true, name} on success, or {id, deleted: false} if the tag was not
   * found for this team. Confirm with the user before calling.
   * @remarks DESTRUCTIVE. Two gates guard it: your credential must carry the
   * \`apis.all\` scope, and your team must have destructive AI tools enabled in
   * team settings. If either is closed the tool is not exposed at all, so a
   * credential alone cannot reach it.
   */
  delete(params: TagsDeleteParams): Promise<ToolResult> {
    return this.#caller.callTool(TAGS_TOOLS.delete, params);
  }
}
"
`;

